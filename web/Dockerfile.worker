# Dockerfile.worker — Item #5 do plano de execução.
# Imagem Node 22 LTS, instala deps do worker (pdf-parse, tesseract.js,
# jsqr, pngjs, @react-pdf/renderer) e roda scripts/worker.ts.
#
# Use:
#   docker build -f Dockerfile.worker -t plataforma-worker .
#   docker run --rm -e DATABASE_URL=... plataforma-worker
#
# Configuração Railway/Fly.io: pasta raiz do projeto é `web/`.
# Comando de start: `npx tsx scripts/worker.ts`

FROM node:22-bookworm-slim AS base

# Tesseract (system tesseract-ocr) se futuro fallback for nativo.
# Em runtime atual usa tesseract.js (WASM) — mas mantemos o apt para fallback opcional.
RUN apt-get update -y && apt-get install -y --no-install-recommends \
    tesseract-ocr tesseract-ocr-por ca-certificates curl \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Instala deps primeiro (cache-friendly).
COPY package.json package-lock.json* ./
RUN npm ci --legacy-peer-deps --omit=dev --no-audit --no-fund

# Copia só o que o worker precisa (cascata + queue + observabilidade + jobs).
# Em produção real, multi-stage copy só o necessário; aqui single-stage
# porque o worker é pequeno e o tsx cobre transpiler on-the-fly.
COPY tsconfig.json next.config.mjs* ./
COPY lib ./lib
COPY scripts ./scripts
COPY drizzle ./drizzle

# Health-check do container — não trava filas, mas responde a /health.
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "process.exit(0)" || exit 1

# Variáveis padrão (sobrescreva via -e no `docker run`).
ENV NODE_ENV=production \
    PORT=8080 \
    EXTRACTION_MODE=real \
    FOLLOWUP_NOTIFY_ENABLED=false

# Sobe o worker; SIGTERM é capturado em scripts/worker.ts (shutdown()).
ENTRYPOINT ["npx", "tsx", "scripts/worker.ts"]
