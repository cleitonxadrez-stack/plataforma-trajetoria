# ──────────────────────────────────────────────────────────────
# Plataforma Trajetória — variáveis de ambiente
# 12 variáveis capturadas por grep no código (set 2026-08-10).
# Esse é o SET MÍNIMO necessário para next build + runtime.
# Nenhum valor default; tudo explícito. (01-arquitetura.md §2 — "privado por padrão")
# ──────────────────────────────────────────────────────────────

# ── Banco de dados (Supabase Postgres 16) ────────────────────
# Conexão "Transaction" + pooler do Supabase. NUNCA use a string direta da
# dashboard porque ela pula o pooler. Use "Transaction pooler" + porta 6543.
DATABASE_URL=postgres://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# ── Supabase Auth — Exposto ao cliente ────────────────────────
# Project Settings → API. SEMPRE seguro mostrar; controlados por RLS no banco.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ── URL canônica do site ──────────────────────────────────────
# Usada para montar links de e-mail (signup confirmation, recovery).
# SEM https:// no uso de canonical.
NEXT_PUBLIC_SITE_URL=https://SEU-DOMINIO.example

# ── Cloudflare R2 — versões fria e quente ────────────────────
# "frio"  = originais imutáveis (originals/yyyy/mm/dd/...)
# "quente" = versões otimizadas servidas pela CDN pública
# Endpoint: https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=r2_xxx
R2_SECRET_ACCESS_KEY=xxx
R2_BUCKET_FRIO=plataforma-frio
R2_BUCKET_QUENTE=plataforma-quente
# Provisionamento R2:
#   1. Criar conta Cloudflare + bucket plataforma-frio + bucket plataforma-quente
#   2. Token: Object Read & Write, bucket-scoped a esses 2 buckets, TTL 90 dias
#   3. Validar: npx tsx scripts/check-r2.ts  (espera exit 0)
#   4. Validar pós-deploy: GET /api/health?ready=1 → checks.r2.ok=true

# ── IA — chaves opcionais; só ativadas em caminho de extração ──
# Bloco 2 passo 6 + parser de edital fallback. NUNCA obrigatórias.
# Sem preencher, cascata cai no passo 5 (Tesseract local) ou parser
# retorna status=INSUFICIENTE no edital e exige revisão manual.
IA_EXTRACTION_API_KEY=
IA_CLASSIFY_API_KEY=

# ── Operacional (Bloco 7) ────────────────────────────────────
# FOLLOWUP_NOTIFY_ENABLED=true liga o transporte real. Sem isto, o
# worker continua contando/logando mas NÃO envia e-mail (dry-run).
# Escolha UM provedor — SMTP ou Webhook — ou deixe cair em console.
FOLLOWUP_NOTIFY_ENABLED=false

# From padrão (opcional; senão usa "noreply@plataforma.local")
EMAIL_FROM=no-reply@plataforma.local

# ▸ SMTP via nodemailer (opção 1). Requer pacote `nodemailer` instalado.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASSWORD=secret
# SMTP_FROM=plataforma@example.com

# ▸ Webhook (Resend-compatível) (opção 2).
# EMAIL_WEBHOOK_URL=https://api.resend.com/emails
# EMAIL_WEBHOOK_SECRET=re_xxx

# ── Cron (Bloco 7) ────────────────────────────────────────────
# CRON_SECRET — exigido por TODOS os endpoints /api/cron/* em produção.
# Sem `CRON_SECRET` em produção, followup-requests ainda funciona (auth permissivo),
# mas alert-job-failures, build-recovery, detect-duplicates, pdf-generate e
# compute-indicators RETORNAM 401 (fail-closed). Gere um uuid v4 e rotacione a
# cada 90 dias alinhado ao ciclo de tokens R2.
# CRON_SECRET=

# ALERT_ADMIN_EMAIL — destinatário dos planos warn|critical emitidos pelo
# /api/cron/alert-job-failures (03:00 UTC). Sem preencher, plano é calculado
# mas o e-mail NÃO é disparado (dry-run aplicado por sendEmail).
# ALERT_ADMIN_EMAIL=ops@example.com
