{
  "name": "plataforma-trajetoria-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed-trajetoria-v1.ts",
    "worker": "tsx --env-file=.env scripts/worker.ts",
    "smoke": "bash scripts/smoke-deploy.sh",
    "check:r2": "tsx scripts/check-r2.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.682.0",
    "@aws-sdk/s3-request-presigner": "^3.682.0",
    "@react-pdf/renderer": "^4.6.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.45.4",
    "drizzle-orm": "^0.36.4",
    "jsqr": "^1.4.0",
    "next": "^15.5.23",
    "nodemailer": "^9.0.5",
    "pdf-parse": "^2.4.5",
    "pg-boss": "^10.1.1",
    "pngjs": "^7.0.0",
    "postgres": "^3.4.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.28.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.4"
  }
}
