{
  "version": 2,
  "buildCommand": "npm run build",
  "installCommand": "npm ci --legacy-peer-deps",
  "framework": "nextjs",
  "regions": ["gru1"],
  "crons": [
    {
      "path": "/api/cron/followup-requests",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/build-recovery",
      "schedule": "15 2 * * *"
    },
    {
      "path": "/api/cron/compute-indicators",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/cron/detect-duplicates",
      "schedule": "45 2 * * *"
    },
    {
      "path": "/api/cron/alert-job-failures",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/pdf-regenerate",
      "schedule": "0 4 * * *"
    }
  ],
  "headers": [
    {
      "source": "/verificar/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
