{
  "version": 2,
  "buildCommand": "npm run build",
  "installCommand": "npm ci --legacy-peer-deps",
  "framework": "nextjs",
  "regions": ["gru1"],
  "//crons": "Removidos por ora: o plano Hobby da Vercel limita a 2 cron jobs. O agendamento roda no worker (pg-boss/scheduleDaily). Reative aqui num plano Pro se quiser os crons na Vercel.",
  "headers": [
    {
      "source": "/verificar/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
